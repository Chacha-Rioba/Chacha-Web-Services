PORT=3001
APP_ORIGIN=http://localhost:5173
DATA_DIR=./data
# Set to production behind an HTTPS reverse proxy.
NODE_ENV=development
# Comma-separated staff identities. Access still requires email verification.
ADMIN_EMAILS=
# Required for sign-in emails and project notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
STAFF_EMAIL=
# Optional production public business contact.
PUBLIC_CONTACT_EMAIL=
# Must be explicit; never exposes sign-in links on production.
DEV_AUTH_LINKS=false
